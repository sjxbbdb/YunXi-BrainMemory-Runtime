# YunXi-BrainMemory-Runtime v0.1 — Environment Configuration
# Product release numbering is v0.1, v0.2, ...; V3–V13 labels in comments
# and API paths identify historical capability/compatibility layers. V3 is
# retained only for legacy pipeline/storage migration; public APIs start at V4.
# Copy this file to .env and fill in your API keys

# DeepSeek V4.1 Flash (primary LLM, required; API model: deepseek-flash)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# P7 two-phase authorization manifest key (shared by --prepare/--authorize).
# Use a random value of at least 16 bytes; never commit the real value.
YUNXI_BRAIN_P7_MANIFEST_KEY=replace-with-a-random-local-secret

# Optional fixed local Docker image/context for P7 (must be digest-pinned).
# YUNXI_BRAIN_P7_DOCKER_IMAGE=python@sha256:<64-hex-digest>

# DashScope (text embeddings, required)
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# GLM-4 (fallback LLM, optional)
GLM_API_KEY=

# Verifiable information sources (no search-provider key required)
# Default: official Wikipedia JSON API. Add arxiv and/or feeds when needed.
YUNXI_BRAIN_SOURCE_PROVIDERS=wikipedia
YUNXI_BRAIN_SOURCE_WIKIPEDIA_LANGS=zh,en
# Comma-separated HTTPS RSS/Atom URLs; use {query} only for a documented query feed.
# YUNXI_BRAIN_SOURCE_FEEDS=
YUNXI_BRAIN_SOURCE_TIMEOUT_SEC=8
YUNXI_BRAIN_SOURCE_CACHE_TTL_SEC=60

# Set to 1 for a fully offline run (source results become simulated).
# YUNXI_BRAIN_OFFLINE=1

# Hard limit for retrieval/LLM work inside one heartbeat.  A timeout falls
# back to a local think-only result so the heartbeat can keep running.
YUNXI_BRAIN_COGNITIVE_TIMEOUT_SEC=1

# Long-term task policy (one execution lane; bounded tiered queue)
YUNXI_BRAIN_TASK_QUEUE_LIMIT=12
YUNXI_BRAIN_TASK_MAINTENANCE_BUDGET_TICKS=60
YUNXI_BRAIN_TASK_USER_BUDGET_TICKS=120
YUNXI_BRAIN_TASK_EXPLORATION_BUDGET_TICKS=90
YUNXI_BRAIN_TASK_MAINTENANCE_DEADLINE_TICKS=180
YUNXI_BRAIN_TASK_USER_DEADLINE_TICKS=360
YUNXI_BRAIN_TASK_EXPLORATION_DEADLINE_TICKS=240

# V13 bounded execution ledger (deterministic verification; no automatic
# side-effect writes).  Unknown/simulated outcomes never complete a task.
YUNXI_BRAIN_TASK_EXECUTION_ENABLED=1
YUNXI_BRAIN_TASK_EXECUTION_MAX_PLANS=32
YUNXI_BRAIN_TASK_EXECUTION_MAX_STEPS=8
YUNXI_BRAIN_TASK_EXECUTION_MAX_DEPTH=3
YUNXI_BRAIN_TASK_EXECUTION_MAX_RETRIES=2
YUNXI_BRAIN_TASK_EXECUTION_MAX_ACTIONS=128
YUNXI_BRAIN_TASK_EXECUTION_MAX_OBSERVATIONS=128
YUNXI_BRAIN_TASK_EXECUTION_MAX_OUTCOMES=128
YUNXI_BRAIN_TASK_EXECUTION_MAX_EVENTS=256
YUNXI_BRAIN_TASK_EXECUTION_REQUIRE_VERIFIED_COMPLETION=1
YUNXI_BRAIN_TASK_EXECUTION_AUTO_REPLAN=0

# Legacy BRAIN_MEMORY_* names still work during the compatibility period with a deprecation warning.
